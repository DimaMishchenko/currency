    "Open the widget again to capture its current amounts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the widget again to capture its current amounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新打开小组件以获取其当前金额。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットをもう一度開いて現在の金額を取得してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir el widget para obtener sus importes actuales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Widget erneut, um seine aktuellen Beträge zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez le widget pour récupérer ses montants actuels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o widget novamente para capturar seus valores atuais."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 다시 열어 현재 금액을 가져오세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新開啟小工具以取得目前金額。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri il widget per acquisire gli importi attuali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncel tutarları almak için araç takımını yeniden açın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте виджет снова, чтобы получить текущие суммы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте віджет знову, щоб отримати поточні суми."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava vidin uuesti, et laadida selle praegused summad."
          }
        }
      }
    },
