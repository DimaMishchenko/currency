    "To use Local currency, open Currency and set up location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Local currency, open Currency and set up location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用当地货币，请打开 Currency 并设置定位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現地通貨を使うには、Currencyを開いて位置情報を設定してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar la moneda local, abre Currency y configura la ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die lokale Währung zu verwenden, öffne Currency und richte den Standort ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser la devise locale, ouvre Currency et configure la position."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar a moeda local, abra o Currency e configure a localização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지 통화를 사용하려면 Currency를 열고 위치를 설정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用當地貨幣，請打開 Currency 並設定定位。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare la valuta locale, apri Currency e configura la posizione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel para birimini kullanmak için Currency’yi açın ve konumu ayarlayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать местную валюту, откройте Currency и настройте местоположение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати місцеву валюту, відкрийте Currency і налаштуйте розташування."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohaliku valuuta kasutamiseks ava Currency ja seadista asukoht."
          }
        }
      }
    },
