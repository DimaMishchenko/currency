    "Enter an amount without grouping, such as 100 or 12.50.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount without thousands separators, such as 100 or 12.50."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含千位分隔符的金额，例如 100 或 12.50。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100や12.50のように、桁区切りなしで金額を入力してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un importe sin separadores de miles, como 100 o 12.50."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Betrag ohne Tausendertrennzeichen ein, zum Beispiel 100 oder 12.50."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis un montant sans séparateurs de milliers, comme 100 ou 12.50."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um valor sem separadores de milhares, como 100 ou 12.50."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100 또는 12.50처럼 천 단위 구분 기호 없이 금액을 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入不含千位分隔符的金額，例如 100 或 12.50。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo senza separatori delle migliaia, ad esempio 100 o 12.50."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "100 veya 12.50 gibi, binlik ayırıcı içermeyen bir tutar girin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите сумму без разделителей разрядов, например 100 или 12.50."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть суму без роздільників розрядів, наприклад 100 або 12.50."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta summa ilma tuhandeliste eraldajateta, näiteks 100 või 12.50."
          }
        }
      }
    },
