    "Convert an amount between currencies, crypto or metals.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert an amount between currencies, crypto or metals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在货币、加密货币或贵金属之间换算金额。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨、暗号資産、貴金属の間で金額を換算します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un importe entre monedas, criptomonedas o metales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne einen Betrag zwischen Währungen, Kryptowährungen oder Metallen um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertis un montant entre devises, cryptomonnaies ou métaux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converta um valor entre moedas, criptomoedas ou metais."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화, 암호화폐 또는 귀금속 간 금액을 환산합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在貨幣、加密貨幣或貴金屬之間換算金額。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converti un importo tra valute, criptovalute o metalli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tutarı para birimleri, kripto paralar veya metaller arasında çevirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертировать сумму между валютами, криптовалютами или металлами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертувати суму між валютами, криптовалютами або металами."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisenda summa valuutade, krüptovaluutade või metallide vahel."
          }
        }
      }
    },
