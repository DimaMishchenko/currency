    "A currency symbol for your Lock Screen. Tap to open Currency.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A currency symbol for your Lock Screen. Tap to open Currency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に通貨記号を表示します。タップするとCurrencyが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 통화 기호를 표시합니다. 탭하여 Currency를 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕上显示货币符号。轻点以打开 Currency。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面上顯示貨幣符號。點一下即可開啟 Currency。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un símbolo de moneda para tu pantalla de bloqueo. Toca para abrir Currency."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un symbole de devise pour ton écran verrouillé. Touche pour ouvrir Currency."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Währungssymbol für deinen Sperrbildschirm. Tippe, um Currency zu öffnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um símbolo de moeda para a Tela Bloqueada. Toque para abrir o Currency."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un simbolo di valuta per la schermata di blocco. Tocca per aprire Currency."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit Ekranınız için bir para birimi simgesi. Currency uygulamasını açmak için dokunun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ валюты на экране блокировки. Нажмите, чтобы открыть Currency."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ валюти на замкненому екрані. Торкніться, щоб відкрити Currency."
          }
        }
      }
    },
