    "historyDescription": {
      "extractionState": "manual",
      "comment": "History widget: historyDescription.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two currencies and their exchange-rate history. 1D refreshes hourly where available; other ranges daily."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种货币及其汇率历史。支持时，1 日范围每小时更新，其他范围每日更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの通貨と為替レートの履歴。1日は対応している場合に毎時更新し、その他の期間は毎日更新します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos monedas y el historial de su tipo de cambio. 1D se actualiza cada hora cuando está disponible; los demás periodos, a diario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Währungen und ihr Wechselkursverlauf. 1T wird stündlich aktualisiert, sofern verfügbar; andere Zeiträume täglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux devises et leur historique de taux de change. 1J s’actualise chaque heure si disponible ; les autres périodes chaque jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas moedas e seu histórico de câmbio. 1D atualiza a cada hora quando disponível; os demais períodos, diariamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 통화의 환율 추이를 보여 줍니다. 1일은 지원되는 경우 매시간 갱신하며, 다른 기간은 매일 갱신합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種貨幣及其匯率歷史。支援時，1 日範圍每小時更新，其他範圍每日更新。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due valute e la cronologia del loro tasso di cambio. 1G si aggiorna ogni ora, dove disponibile; gli altri periodi ogni giorno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki para birimi ve döviz kuru geçmişleri. 1G, kullanılabildiğinde saatlik; diğer aralıklar günlük yenilenir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две валюты и история их курса обмена. За 1Д данные обновляются каждый час, где это доступно; за остальные периоды — ежедневно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві валюти та історія їхнього курсу обміну. За 1Д дані оновлюються щогодини, де це доступно; за інші періоди — щодня."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaks valuutat ja nende vahetuskursi ajalugu. 1p värskendatakse võimalusel iga tund, teisi perioode iga päev."
          }
        }
      }
    },
