          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondalıklar için nokta veya virgül kullanan, basamak ayırıcı içermeyen pozitif bir sayı."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положительное число с точкой или запятой для дробной части, без разделителей разрядов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатне число з крапкою або комою для дробової частини, без роздільників розрядів."
          }
        },
        "et": {
          "stringUnit": {
