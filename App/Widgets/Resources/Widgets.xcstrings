    "amountHelp": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A positive number, using a dot or comma for decimals, without grouping separators."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正数，小数可用点或逗号表示，不含千位分隔符。"
