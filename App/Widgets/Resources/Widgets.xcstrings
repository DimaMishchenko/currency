          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre positif, avec un point ou une virgule pour les décimales, sans séparateurs de milliers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um número positivo, com ponto ou vírgula para os decimais, sem separadores de milhares."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자릿수 구분 기호 없이 양수를 입력하세요. 소수에는 점이나 쉼표를 사용합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
