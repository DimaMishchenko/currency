    "pocketDescription": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One useful, automatically chosen reference amount for your currency pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您的货币对自动选择一个实用参考金额。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨ペアに合わせて参考金額を自動で選択。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un importe de referencia útil, elegido automáticamente para tu par de monedas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nützlicher, automatisch gewählter Referenzbetrag für dein Währungspaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un montant de référence utile, choisi automatiquement pour ta paire de devises."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor de referência útil, escolhido automaticamente para seu par de moedas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 쌍에 맞춰 유용한 참고 금액 하나를 자동으로 선택합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您的貨幣對自動選擇一個實用參考金額。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un importo di riferimento utile, scelto automaticamente per la tua coppia di valute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi çiftiniz için otomatik seçilen kullanışlı bir referans tutar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна полезная справочная сумма, автоматически выбранная для вашей валютной пары."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна корисна довідкова сума, автоматично вибрана для вашої валютної пари."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks kasulik võrdlussumma, mis valitakse sinu valuutapaari jaoks automaatselt."
          }
        }
      }
    },
