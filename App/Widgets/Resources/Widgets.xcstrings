    "multiDescription": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Default to follow your app currencies or choose a Custom list. Medium shows up to four currencies; large shows up to eight. Two currencies work as a pair calculator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“默认”以与 App 中的货币列表同步，或选择“自定列表”。中型最多显示四种货币，大型最多显示八种。选择两种货币即可在两者之间进行换算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」でアプリの通貨リストと連動させるか、「カスタムリスト」で通貨を選択します。中サイズは最大4通貨、大サイズは最大8通貨を表示します。2通貨を選ぶと、そのペアの換算計算機になります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Predeterminado para seguir las monedas de tu app o elige una Lista personalizada. El tamaño mediano muestra hasta cuatro monedas; el grande, hasta ocho. Dos monedas funcionan como calculadora de un par."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Standard für die Währungen deiner App oder wähle eine Eigene Liste. Mittel zeigt bis zu vier Währungen, Groß bis zu acht. Zwei Währungen bilden einen Paarrechner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Par défaut pour suivre les devises de ton app ou choisis une Liste personnalisée. Le format moyen affiche jusqu’à quatre devises et le grand jusqu’à huit. Deux devises fonctionnent comme une calculatrice de paire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Padrão para acompanhar as moedas do app ou escolha uma Lista personalizada. O tamanho médio mostra até quatro moedas; o grande, até oito. Duas moedas funcionam como uma calculadora de par."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로 앱의 통화 목록과 동기화하거나 사용자 지정 목록을 선택하세요. 중형은 최대 4개, 대형은 최대 8개 통화를 표시합니다. 통화 2개를 선택하면 두 통화 간 환산 계산기로 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「預設」以與 App 中的貨幣列表同步，或選擇「自訂列表」。中型最多顯示四種貨幣，大型最多顯示八種。選擇兩種貨幣即可在兩者之間進行換算。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Predefinito per seguire le valute dell’app o scegli un Elenco personalizzato. Il formato medio mostra fino a quattro valute, il grande fino a otto. Due valute funzionano come calcolatrice di coppia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki para birimlerini izlemek için Varsayılan’ı kullanın veya Özel liste seçin. Orta boyutta dörde, büyük boyutta sekize kadar para birimi görünür. İki para birimiyle bir çift hesaplayıcı oluşur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «По умолчанию», чтобы использовать валюты приложения, или «Свой список». Средний размер показывает до четырёх валют, большой — до восьми. Две валюты работают как калькулятор пары."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Типово», щоб використовувати валюти програми, або «Власний список». Середній розмір показує до чотирьох валют, великий — до восьми. Дві валюти працюють як калькулятор пари."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduse valuutade kasutamiseks vali Vaikimisi või vali Kohandatud loend. Keskmine vidin näitab kuni nelja, suur kuni kaheksat valuutat. Kahe valuutaga töötab see valuutapaari kalkulaatorina."
          }
        }
      }
    },
