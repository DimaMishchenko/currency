    "calculatorListHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default follows your app currencies. Choose Custom list to edit a separate selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“默认”与 App 中的货币列表同步。选择“自定列表”可设置独立的货币列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」はアプリの通貨リストと連動します。別の通貨を選ぶには「カスタムリスト」を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado sigue las monedas de tu app. Elige Lista personalizada para editar una selección independiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard folgt den Währungen deiner App. Wähle Eigene Liste, um eine separate Auswahl zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut suit les devises de ton app. Choisis Liste personnalisée pour modifier une sélection indépendante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão acompanha as moedas do app. Escolha Lista personalizada para editar uma seleção separada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 앱의 통화 목록과 동기화됩니다. 별도의 통화를 선택하려면 사용자 지정 목록을 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」與 App 中的貨幣列表同步。選擇「自訂列表」可設定獨立的貨幣列表。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito segue le valute dell’app. Scegli Elenco personalizzato per modificare una selezione separata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan uygulamadaki para birimlerini izler. Ayrı bir seçimi düzenlemek için Özel liste’yi seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«По умолчанию» использует валюты приложения. Выберите «Свой список», чтобы изменить отдельный набор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Типово» використовує валюти програми. Виберіть «Власний список», щоб змінити окремий набір."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikimisi kasutab rakenduse valuutasid. Eraldi valiku muutmiseks vali Kohandatud loend."
          }
        }
      }
    },
    "Medium shows the first 4 currencies. Additional currencies appear on Large.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium shows the first 4 currencies. Additional currencies appear on Large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中型显示前四种货币。更多货币显示在大型中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中サイズは最初の4通貨を表示。追加の通貨は大サイズに表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño mediano muestra las primeras 4 monedas. Las monedas adicionales aparecen en el grande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel zeigt die ersten 4 Währungen. Weitere Währungen erscheinen in Groß."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format moyen affiche les 4 premières devises. Les devises supplémentaires apparaissent en grand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho médio mostra as primeiras 4 moedas. As moedas adicionais aparecem no grande."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중형은 처음 4개 통화를 표시합니다. 추가 통화는 대형에 표시됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中型顯示前四種貨幣。更多貨幣顯示在大型中。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato medio mostra le prime 4 valute. Le altre compaiono nel formato grande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta boyutta ilk 4 para birimi görünür. Diğerleri büyük boyutta gösterilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний размер показывает первые 4 валюты. Остальные появляются в большом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середній розмір показує перші 4 валюти. Решта з’являються у великому."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskmine vidin näitab nelja esimest valuutat. Ülejäänud ilmuvad suures vidinas."
          }
        }
      }
    },
    "Large shows the first 8 currencies. Medium shows the first 4.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large shows the first 8 currencies. Medium shows the first 4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大型显示前八种货币，中型显示前四种。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大サイズは最初の8通貨、中サイズは最初の4通貨を表示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño grande muestra las primeras 8 monedas. El mediano muestra las primeras 4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Groß zeigt die ersten 8 Währungen. Mittel zeigt die ersten 4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le grand format affiche les 8 premières devises. Le moyen affiche les 4 premières."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho grande mostra as primeiras 8 moedas. O médio mostra as primeiras 4."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대형은 처음 8개, 중형은 처음 4개 통화를 표시합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大型顯示前八種貨幣，中型顯示前四種。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato grande mostra le prime 8 valute. Il medio mostra le prime 4."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük boyutta ilk 8 para birimi görünür. Orta boyutta ilk 4 görünür."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большой размер показывает первые 8 валют. Средний — первые 4."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великий розмір показує перші 8 валют. Середній — перші 4."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suur vidin näitab kaheksat esimest valuutat. Keskmine näitab nelja esimest."
          }
        }
      }
    },
    "Medium follows the first 4 app currencies, including Local when selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium follows the first 4 app currencies, including Local when selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中型跟随 App 的前四种货币，包括已选择的当地货币。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中サイズはアプリの最初の4通貨に従い、選択されていれば現地通貨も含みます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño mediano sigue las primeras 4 monedas de la app, incluida Local si está seleccionada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel folgt den ersten 4 App-Währungen, einschließlich Lokal, falls ausgewählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format moyen suit les 4 premières devises de l’app, dont Locale si elle est sélectionnée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho médio acompanha as primeiras 4 moedas do app, incluindo Local quando selecionada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중형은 앱의 처음 4개 통화를 따르며, 선택한 경우 현지 통화도 포함합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中型跟隨 App 的前四種貨幣，包括已選擇的當地貨幣。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato medio segue le prime 4 valute dell’app, inclusa Locale se selezionata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta boyut, seçiliyse Yerel dahil uygulamadaki ilk 4 para birimini izler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний размер использует первые 4 валюты приложения, включая местную, если она выбрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середній розмір використовує перші 4 валюти програми, включно з місцевою, якщо її вибрано."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskmine vidin kasutab rakenduse nelja esimest valuutat, sealhulgas kohalikku valuutat, kui see on valitud."
          }
        }
      }
    },
