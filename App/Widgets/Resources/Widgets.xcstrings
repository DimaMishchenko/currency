    "cashDescription": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap everyday banknotes or metal weights to see their reference value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点常见纸币或贵金属重量，查看参考价值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身近な紙幣や貴金属の重量をタップして参考価値を確認。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca billetes habituales o pesos de metales para ver su valor de referencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf alltägliche Banknoten oder Metallgewichte, um ihren Referenzwert zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche des billets courants ou des poids de métaux pour voir leur valeur de référence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em notas comuns ou pesos de metais para ver seu valor de referência."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상에서 쓰는 지폐나 귀금속 무게를 탭하여 참고 가치를 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下常見紙鈔或貴金屬重量，查看參考價值。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca banconote comuni o pesi di metalli per vederne il valore di riferimento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans değerlerini görmek için yaygın banknotlara veya metal ağırlıklarına dokunun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на привычные банкноты или выбирайте массу металла, чтобы увидеть их справочную стоимость."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкайтеся звичних банкнот або вибирайте масу металу, щоб побачити їхню довідкову вартість."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta levinud rahatähti või metallide kaaluvalikuid, et näha nende võrdlusväärtust."
          }
        }
      }
    },
