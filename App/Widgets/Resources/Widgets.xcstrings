    "mentalDescription": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rounded multiply or divide rule for quick estimates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用四舍五入的乘除规则快速估算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ざっくり計算できる、丸めた掛け算・割り算のルール。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla redondeada de multiplicación o división para estimaciones rápidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gerundete Multiplikations- oder Divisionsregel für schnelle Schätzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle arrondie de multiplication ou de division pour des estimations rapides."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra arredondada de multiplicação ou divisão para estimativas rápidas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르게 어림할 수 있는 반올림된 곱셈 또는 나눗셈 규칙입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用四捨五入的乘除規則快速估算。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola di moltiplicazione o divisione arrotondata per stime rapide."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı tahminler için yuvarlanmış bir çarpma veya bölme kuralı."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Округлённое правило умножения или деления для быстрых оценок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Округлене правило множення або ділення для швидких оцінок."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ümardatud korrutus- või jagamisreegel kiireks hindamiseks."
          }
        }
      }
    },
    "newBoardDescription": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A base-first currency board. Default follows your app currencies; Custom list keeps its own selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基准货币置于首位的货币看板。“默认”与 App 中的货币列表同步；“自定列表”保留独立选择。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準通貨を先頭に表示する通貨ボード。「デフォルト」はアプリの通貨リストと連動し、「カスタムリスト」は独自の選択を保持します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel con la moneda base primero. Predeterminado sigue las monedas de tu app; Lista personalizada mantiene su propia selección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Übersicht mit der Basiswährung zuerst. Standard folgt den Währungen deiner App; Eigene Liste behält ihre eigene Auswahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau affichant la devise de base en premier. Par défaut suit les devises de ton app ; Liste personnalisée garde sa propre sélection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um painel com a moeda base primeiro. Padrão acompanha as moedas do app; Lista personalizada mantém sua própria seleção."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 통화를 맨 앞에 표시하는 통화 보드입니다. 기본값은 앱의 통화 목록과 동기화되고 사용자 지정 목록은 별도 선택을 유지합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基準貨幣置於首位的貨幣看板。「預設」與 App 中的貨幣列表同步；「自訂列表」保留獨立選擇。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tabellone con la valuta di base per prima. Predefinito segue le valute dell’app; Elenco personalizzato mantiene una selezione separata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel para birimini ilk sırada gösteren pano. Varsayılan uygulamadaki para birimlerini izler; Özel liste kendi seçimini korur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Табло валют с базовой валютой первой. «По умолчанию» использует валюты приложения; «Свой список» сохраняет отдельный набор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табло валют із базовою валютою першою. «Типово» використовує валюти програми; «Власний список» зберігає окремий набір."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuutatabel, kus baasvaluuta on esimene. Vaikimisi kasutab rakenduse valuutasid; Kohandatud loend säilitab eraldi valiku."
          }
        }
      }
    },
