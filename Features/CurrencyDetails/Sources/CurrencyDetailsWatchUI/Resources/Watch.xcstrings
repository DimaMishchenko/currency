    "referenceExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference rates are indicative and may differ from bank or exchange prices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考汇率仅供参考，可能与银行或兑换价格不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考レートは目安であり、銀行や両替所の価格と異なる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos de referencia son orientativos y pueden diferir de los precios de bancos o casas de cambio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzkurse sind Richtwerte und können von Bank- oder Wechselpreisen abweichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux de référence sont indicatifs et peuvent différer des prix bancaires ou de change."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas de referência são indicativas e podem diferir dos preços de bancos ou casas de câmbio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고 환율은 지표이며 은행 또는 환전소 가격과 다를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考匯率僅供參考，可能與銀行或兌換價格不同。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi di riferimento sono indicativi e possono differire dai prezzi di banche o cambiavalute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans kurlar gösterge niteliğindedir ve banka veya döviz fiyatlarından farklı olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справочные курсы ориентировочные и могут отличаться от курсов банков или обменных пунктов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довідкові курси є орієнтовними та можуть відрізнятися від курсів банків або обмінних пунктів."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrdluskursid on soovituslikud ja võivad erineda pankade või valuutavahetuse hindadest."
          }
        }
      }
    },
