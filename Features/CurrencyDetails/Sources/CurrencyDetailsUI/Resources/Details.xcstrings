    "tryAnotherRange": {
      "extractionState": "manual",
      "comment": "Details interface: tryAnotherRange.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another range or return when connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择其他时段，或联网后再查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の期間を選ぶか、接続後にもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro periodo o vuelve cuando tengas conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Zeitraum oder kehre mit Internetverbindung zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie une autre période ou reviens une fois connecté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro período ou volte quando estiver conectado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기간을 선택하거나 연결 후 다시 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇其他期間，或連線後再查看。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro periodo o torna quando sei connesso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir aralık deneyin veya bağlantınız olduğunda geri dönün."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другой период или вернитесь при подключении к интернету."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте інший період або поверніться після підключення до інтернету."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali teine periood või proovi uuesti, kui internetiühendus on olemas."
          }
        }
      }
    },
    "maxExplanation": {
      "extractionState": "manual",
      "comment": "Details interface: maxExplanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All shows all history available from this provider for this pair, grouped monthly. It may begin after the currency launched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“全部”显示此数据来源提供的该货币对全部历史，按月汇总。历史可能从货币推出后的某个时间开始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「全期間」は、この提供元で利用できる通貨ペアのすべての履歴を月ごとにまとめて表示します。通貨の開始時点より後から始まる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo muestra todo el historial disponible de este proveedor para este par, agrupado por meses. Puede comenzar después del lanzamiento de la moneda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zeigt den gesamten verfügbaren Verlauf dieses Anbieters für dieses Paar, monatlich gruppiert. Er kann erst nach Einführung der Währung beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout affiche tout l’historique disponible chez ce fournisseur pour cette paire, regroupé par mois. Il peut commencer après le lancement de la devise."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo mostra todo o histórico disponível deste provedor para este par, agrupado por mês. Ele pode começar após o lançamento da moeda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체는 이 제공업체에서 이용할 수 있는 해당 통화 쌍의 모든 과거 환율을 월별로 묶어 표시합니다. 통화 출시 이후의 시점부터 시작할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「全部」顯示此資料來源提供的該貨幣對所有歷史，按月彙整。歷史可能從貨幣推出後的某個時間開始。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto mostra tutta la cronologia disponibile da questo fornitore per la coppia, raggruppata per mese. Può iniziare dopo il lancio della valuta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümü, bu sağlayıcıdan bu çift için kullanılabilir tüm geçmişi aylık gruplar halinde gösterir. Para biriminin çıkışından sonra başlayabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Все» показывает всю историю, доступную у этого поставщика для этой пары, с группировкой по месяцам. Она может начинаться позже появления валюты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Усе» показує всю історію, доступну в цього постачальника для цієї пари, з групуванням за місяцями. Вона може починатися після появи валюти."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik näitab selle pakkuja kogu saadaolevat kursiajalugu valitud valuutapaari kohta, kuude kaupa. Ajalugu võib alata pärast valuuta kasutuselevõttu."
          }
        }
      }
    },
    "cryptoExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crypto history uses completed Coinbase candles and, where needed, reference exchange rates. Historical and current conversion sources may differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密货币历史使用 Coinbase 已收盘的 K 线，并在需要时使用参考汇率。历史和当前换算的数据来源可能不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号資産の履歴にはCoinbaseの確定済みローソク足を使用し、必要に応じて参考為替レートも使用します。過去と現在の換算データは異なる提供元を使う場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de criptomonedas usa velas cerradas de Coinbase y, cuando es necesario, tipos de cambio de referencia. Las fuentes de las conversiones históricas y actuales pueden diferir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kryptoverlauf verwendet abgeschlossene Coinbase-Kerzen und bei Bedarf Referenzwechselkurse. Historische und aktuelle Umrechnungskurse können aus unterschiedlichen Quellen stammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des cryptomonnaies utilise les bougies clôturées de Coinbase et, si nécessaire, des taux de change de référence. Les sources des conversions historiques et actuelles peuvent différer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de criptomoedas usa candles fechados da Coinbase e, quando necessário, taxas de câmbio de referência. As fontes das conversões históricas e atuais podem diferir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화폐의 과거 데이터는 Coinbase의 마감된 캔들을 사용하며, 필요한 경우 참고 환율도 적용합니다. 과거 환율과 현재 환율의 데이터 출처가 다를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密貨幣歷史使用 Coinbase 已收盤的 K 線，並在需要時使用參考匯率。歷史和目前換算的資料來源可能不同。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia delle criptovalute usa candele completate di Coinbase e, quando necessario, tassi di cambio di riferimento. Le fonti delle conversioni storiche e attuali possono differire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kripto para geçmişi, tamamlanmış Coinbase mumlarını ve gerektiğinde referans döviz kurlarını kullanır. Geçmiş ve güncel çevirme kurları farklı kaynaklardan gelebilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История криптовалют использует завершённые свечи Coinbase и, при необходимости, справочные курсы обмена. Источники исторических и текущих курсов могут отличаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія криптовалют використовує завершені свічки Coinbase та, за потреби, довідкові курси обміну. Джерела історичних і поточних курсів можуть відрізнятися."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Krüptovaluutade ajalugu põhineb Coinbase’i suletud hinnaküünaldel ja vajaduse korral võrdluskurssidel. Ajalooliste ja praeguste vahetuskursside allikad võivad erineda."
          }
        }
      }
    },
    "fiatExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference-rate history may have gaps on weekends or when no data is published. Historical and current conversion sources may differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考汇率历史可能在周末或未发布数据时出现空缺。历史和当前换算的数据来源可能不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考レートの履歴には、週末やデータが公表されない日に空白が生じる場合があります。過去と現在の換算データは異なる提供元を使う場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de tipos de referencia puede tener huecos durante los fines de semana o cuando no se publican datos. Las fuentes de las conversiones históricas y actuales pueden diferir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Referenzkursverlauf können an Wochenenden oder bei fehlenden Veröffentlichungen Lücken auftreten. Historische und aktuelle Umrechnungskurse können aus unterschiedlichen Quellen stammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des taux de référence peut comporter des interruptions pendant les week-ends ou lorsque les données ne sont pas publiées. Les sources des conversions historiques et actuelles peuvent différer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de taxas de referência pode ter lacunas nos fins de semana ou quando não há publicação de dados. As fontes das conversões históricas e atuais podem diferir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 참고 환율에는 주말이나 데이터가 발표되지 않는 날에 공백이 있을 수 있습니다. 과거 환율과 현재 환율의 데이터 출처가 다를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考匯率歷史可能在週末或未發布資料時出現空缺。歷史和目前換算的資料來源可能不同。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia dei tassi di riferimento può avere lacune nei fine settimana o quando non vengono pubblicati dati. Le fonti delle conversioni storiche e attuali possono differire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans kur geçmişinde hafta sonları veya veri yayımlanmadığında boşluklar olabilir. Geçmiş ve güncel çevirme kurları farklı kaynaklardan gelebilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В истории справочных курсов возможны пропуски в выходные или при отсутствии опубликованных данных. Источники исторических и текущих курсов могут отличаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В історії довідкових курсів можливі прогалини у вихідні або за відсутності опублікованих даних. Джерела історичних і поточних курсів можуть відрізнятися."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrdluskursside ajaloos võib olla lünki nädalavahetustel või siis, kui andmeid ei avaldata. Ajalooliste ja praeguste vahetuskursside allikad võivad erineda."
          }
        }
      }
    },
