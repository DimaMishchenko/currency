    "intradayExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiat history uses daily reference rates. Choose 1W or a longer range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法定货币历史使用每日参考汇率。请选择 1 周或更长范围。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法定通貨の履歴は日次参考レートを使用します。1週間以上の期間を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de monedas fiduciarias usa tipos de cambio de referencia diarios. Elige 1S o un periodo mayor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fiatverlauf verwendet tägliche Referenzkurse. Wähle 1W oder einen längeren Zeitraum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des monnaies fiduciaires utilise des taux de change de référence quotidiens. Choisis 1S ou une période plus longue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de moedas fiduciárias usa taxas de câmbio de referência diárias. Escolha 1S ou um período maior."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법정 통화의 과거 데이터는 일일 참고 환율을 사용합니다. 1주 이상의 기간을 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "法定貨幣歷史使用每日參考匯率。請選擇 1 週或更長範圍。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia delle valute tradizionali usa tassi di riferimento giornalieri. Scegli 1S o un periodo più lungo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtibari para birimi geçmişi günlük referans kurlarını kullanır. 1H veya daha uzun bir aralık seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История обычных валют использует ежедневные справочные курсы. Выберите 1Н или более длительный период."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія звичайних валют використовує щоденні довідкові курси. Виберіть 1Т або довший період."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavavaluutade ajalugu põhineb igapäevastel võrdluskurssidel. Vali 1n või pikem periood."
          }
        }
      }
    }
  },
  "version": "1.0"
}
