    "tryAnotherRange": {
      "extractionState": "manual",
      "comment": "Details interface: tryAnotherRange.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another range or return when connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试其他范围，或联网后再查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の期間を選ぶか、接続後にもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro periodo o vuelve cuando tengas conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Zeitraum oder kehre mit Internetverbindung zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie une autre période ou reviens une fois connecté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro período ou volte quando estiver conectado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기간을 선택하거나 연결 후 다시 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請嘗試其他範圍，或連線後再查看。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro periodo o torna quando sei connesso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir aralık deneyin veya bağlantınız olduğunda geri dönün."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другой период или вернитесь при подключении к интернету."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте інший період або поверніться після підключення до інтернету."
          }
        }
      }
    },
    "maxExplanation": {
      "extractionState": "manual",
      "comment": "Details interface: maxExplanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max shows all history available from this provider for this pair, grouped monthly. It may begin after the currency launched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“最大”按月分组显示此提供方对此货币对的全部可用历史。起始时间可能晚于货币推出时间。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最大」は、このプロバイダが提供するこのペアの全履歴を月単位で表示します。通貨の開始日より後から始まる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máx. muestra todo el historial disponible de este proveedor para este par, agrupado por meses. Puede comenzar después del lanzamiento de la moneda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Max zeigt den gesamten verfügbaren Verlauf dieses Anbieters für dieses Paar, monatlich gruppiert. Er kann erst nach Einführung der Währung beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Max affiche tout l’historique disponible chez ce fournisseur pour cette paire, regroupé par mois. Il peut commencer après le lancement de la devise."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máx. mostra todo o histórico disponível deste provedor para este par, agrupado por mês. Ele pode começar após o lançamento da moeda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대는 이 제공업체에서 지원하는 통화 쌍의 전체 내역을 월별로 표시합니다. 통화 출시 이후부터 시작할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「最大」按月分組顯示此提供者對此貨幣對的全部可用歷史。起始時間可能晚於貨幣推出時間。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Max mostra tutta la cronologia disponibile da questo fornitore per la coppia, raggruppata per mese. Può iniziare dopo il lancio della valuta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks., bu sağlayıcıdan bu çift için kullanılabilir tüm geçmişi aylık gruplar halinde gösterir. Para biriminin çıkışından sonra başlayabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Макс.» показывает всю историю, доступную у этого поставщика для этой пары, с группировкой по месяцам. Она может начинаться позже появления валюты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Макс.» показує всю історію, доступну в цього постачальника для цієї пари, з групуванням за місяцями. Вона може починатися пізніше появи валюти."
          }
        }
      }
    },
    "cryptoExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History uses completed Coinbase candles in USD; missing trading days have no observations. Historical and current conversion sources may differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史使用 Coinbase 已完成的美元 K 线；缺失交易日没有观测值。历史和当前换算的数据来源可能不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はCoinbaseの確定済みUSDローソク足を使用します。取引データのない日は表示されません。過去と現在の換算データは異なる提供元を使う場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial usa velas completadas de Coinbase en USD; los días sin negociación no tienen observaciones. Las fuentes de las conversiones históricas y actuales pueden diferir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf verwendet abgeschlossene Coinbase-Kerzen in USD; für Tage ohne Handel gibt es keine Beobachtungen. Historische und aktuelle Umrechnungsquellen können sich unterscheiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique utilise les bougies clôturées de Coinbase en USD ; les jours sans transactions n’ont pas d’observations. Les sources des conversions historiques et actuelles peuvent différer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico usa candles concluídos da Coinbase em USD; dias sem negociação não têm observações. As fontes das conversões históricas e atuais podem diferir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내역은 Coinbase의 완료된 USD 캔들을 사용합니다. 거래일 데이터가 없으면 관측값도 없습니다. 과거와 현재 환산 데이터의 출처가 다를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史使用 Coinbase 已完成的美元 K 線；缺失交易日沒有觀測值。歷史和目前換算的資料來源可能不同。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia usa candele completate di Coinbase in USD; i giorni di negoziazione mancanti non hanno osservazioni. Le fonti storiche e attuali possono differire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş, USD cinsinden tamamlanmış Coinbase mumlarını kullanır; eksik işlem günlerinde gözlem yoktur. Geçmiş ve güncel çevirme kaynakları farklı olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История использует завершённые свечи Coinbase в USD; за пропущенные торговые дни наблюдений нет. Источники исторических и текущих курсов могут отличаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія використовує завершені свічки Coinbase у USD; за пропущені торгові дні спостережень немає. Джерела історичних і поточних курсів можуть відрізнятися."
          }
        }
      }
    },
    "fiatExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference-rate history can have weekend and publication gaps. Historical and current conversion sources may differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考汇率历史可能存在周末和发布日期的空缺。历史和当前换算的数据来源可能不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考レートの履歴には週末や公表日の空白が生じる場合があります。過去と現在の換算データは異なる提供元を使う場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de tipos de referencia puede tener huecos por fines de semana o publicaciones. Las fuentes de las conversiones históricas y actuales pueden diferir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Referenzkursverlauf kann Wochenend- und Veröffentlichungslücken aufweisen. Historische und aktuelle Umrechnungsquellen können sich unterscheiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des taux de référence peut comporter des interruptions liées aux week-ends et aux publications. Les sources des conversions historiques et actuelles peuvent différer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de taxas de referência pode ter lacunas de fins de semana e publicações. As fontes das conversões históricas e atuais podem diferir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고 환율 내역에는 주말 및 발표 공백이 있을 수 있습니다. 과거와 현재 환산 데이터의 출처가 다를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考匯率歷史可能存在週末和發布日期的空缺。歷史和目前換算的資料來源可能不同。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia dei tassi di riferimento può avere lacune nei fine settimana e nelle pubblicazioni. Le fonti storiche e attuali possono differire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans kur geçmişinde hafta sonları ve yayımlamalar arasında boşluklar olabilir. Geçmiş ve güncel çevirme kaynakları farklı olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В истории справочных курсов возможны пропуски в выходные и между публикациями. Источники исторических и текущих курсов могут отличаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В історії довідкових курсів можливі прогалини у вихідні та між публікаціями. Джерела історичних і поточних курсів можуть відрізнятися."
          }
        }
      }
    },
