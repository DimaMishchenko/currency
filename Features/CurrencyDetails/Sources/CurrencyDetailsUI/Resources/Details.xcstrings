    "chartAccessibility": {
      "extractionState": "manual",
      "comment": "Details interface: chartAccessibility.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ to %3$@ exchange-rate history · %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@兑%3$@的汇率历史 · %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@から%3$@への為替レートの履歴 · %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial del tipo de cambio de %2$@ a %3$@ · %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursverlauf von %2$@ in %3$@ · %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique du taux de change de %2$@ en %3$@ · %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico da taxa de câmbio de %2$@ para %3$@ · %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %3$@ 환산 가치 추이 · %1$@"
          }
        },
        "zh-Hant": {
