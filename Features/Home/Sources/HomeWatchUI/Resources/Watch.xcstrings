    "noRates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved rates. Connect to refresh before converting offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已保存的汇率。离线换算前请联网刷新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みレートがありません。オフラインで換算する前に接続して更新してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipos guardados. Conéctate para actualizar antes de convertir sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gespeicherten Kurse. Vor dem Offline-Umrechnen verbinden und aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taux enregistré. Connectez-vous pour actualiser avant de convertir hors ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma taxa salva. Conecte-se para atualizar antes de converter offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 환율이 없습니다. 오프라인 환산 전에 연결하여 새로 고치세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已儲存的匯率。離線換算前請連線更新。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso salvato. Connettiti per aggiornare prima di convertire offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş kur yok. Çevrimdışı dönüştürmeden önce bağlanıp yenileyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сохранённых курсов. Подключитесь для обновления перед конвертацией без сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає збережених курсів. Підключіться для оновлення перед конвертацією без мережі."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
