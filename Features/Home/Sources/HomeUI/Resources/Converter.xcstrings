    "reorderHint": {
      "extractionState": "manual",
      "comment": "Converter interface: reorderHint.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to remove. Tap Edit to reorder. Your widgets follow the same order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻扫以移除，轻点“编辑”以排序。小组件遵循相同顺序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプして削除。「編集」をタップして並べ替えます。ウィジェットも同じ順序に従います。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para eliminar. Toca Editar para reordenar. Tus widgets siguen el mismo orden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische zum Entfernen. Tippe auf Bearbeiten, um die Reihenfolge zu ändern. Deine Widgets folgen derselben Reihenfolge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye pour supprimer. Touche Modifier pour réordonner. Tes widgets suivent le même ordre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para remover. Toque em Editar para reordenar. Seus widgets seguem a mesma ordem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸어넘겨 제거하세요. 편집을 탭하여 순서를 바꾸세요. 위젯도 같은 순서를 따릅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動以移除，點一下「編輯」以排序。小工具遵循相同順序。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rimuovere. Tocca Modifica per riordinare. I widget seguono lo stesso ordine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak için kaydırın. Sıralamak için Düzenle’ye dokunun. Araç takımlarınız aynı sırayı izler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните для удаления. Нажмите «Править», чтобы изменить порядок. Виджеты используют тот же порядок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахніть для видалення. Торкніться «Змінити», щоб змінити порядок. Віджети використовують той самий порядок."
          }
        }
      }
    },
    "selectionSaveFailed": {
      "extractionState": "manual",
      "comment": "Converter interface: selectionSaveFailed.",
      "localizations": {
