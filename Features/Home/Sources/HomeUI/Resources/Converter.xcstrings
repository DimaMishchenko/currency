    "widgetsTipMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find widgets for your Home Screen and learn how to add them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找主屏幕小组件并了解添加方法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面用のウィジェットを見つけ、追加方法を確認。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre widgets para tu pantalla de inicio y aprende a añadirlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Widgets für deinen Home-Bildschirm und erfahre, wie du sie hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre des widgets pour ton écran d’accueil et apprends à les ajouter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre widgets para sua Tela de Início e aprenda a adicioná-los."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 위젯을 찾고 추가 방법을 알아보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找主畫面小工具並了解加入方法。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova widget per la schermata Home e scopri come aggiungerli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekranınız için araç takımları bulun ve nasıl ekleneceğini öğrenin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите виджеты для экрана «Домой» и узнайте, как их добавить."
