          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存您的選擇。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la tua selezione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçiminiz kaydedilemedi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ваш выбор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ваш вибір."
          }
        }
      }
    },
    "rateSaveFailed": {
      "extractionState": "manual",
      "comment": "Converter interface: rateSaveFailed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates updated, but couldn’t be saved for offline use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率已更新，但无法保存以供离线使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートを更新しましたが、オフライン用に保存できませんでした。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos de cambio se han actualizado, pero no se pudieron guardar para usarlos sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurse wurden aktualisiert, konnten aber nicht für die Offline-Nutzung gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux ont été actualisés, mais n’ont pas pu être enregistrés pour une utilisation hors ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas foram atualizadas, mas não puderam ser salvas para uso offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환율이 갱신되었지만 오프라인으로 저장하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率已更新，但無法儲存以供離線使用。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassi aggiornati, ma non salvati per l’uso offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurlar güncellendi ancak çevrimdışı kullanım için kaydedilemedi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсы обновлены, но их не удалось сохранить для работы без интернета."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курси оновлено, але їх не вдалося зберегти для роботи без інтернету."
          }
        }
      }
    },
