          "stringUnit": {
            "state": "translated",
            "value": "Переглянути історію курсу"
          }
        }
      }
    },
    "historyTipMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how this exchange rate has changed over time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看此汇率随时间的变化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートの時間による変化を確認。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cómo ha variado este tipo de cambio con el tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir an, wie sich dieser Wechselkurs im Laufe der Zeit verändert hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre comment ce taux de change a évolué au fil du temps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como esta taxa de câmbio mudou ao longo do tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간에 따른 환율 변화를 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看此匯率隨時間的變化。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri come è cambiato questo tasso nel tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu döviz kurunun zaman içinde nasıl değiştiğini görün."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, как этот курс менялся со временем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, як цей курс змінювався з часом."
          }
        }
      }
    },
