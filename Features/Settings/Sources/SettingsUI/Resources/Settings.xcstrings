    "metalUnitExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the unit used for precious metal amounts. One troy ounce equals 31.1034768 grams."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Einheit für Edelmetallmengen. Eine Feinunze entspricht 31,1034768 Gramm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la unidad para las cantidades de metales preciosos. Una onza troy equivale a 31,1034768 gramos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’unité des quantités de métaux précieux. Une once troy équivaut à 31,1034768 grammes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l’unità per le quantità di metalli preziosi. Un’oncia troy equivale a 31,1034768 grammi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a unidade para as quantidades de metais preciosos. Uma onça troy equivale a 31,1034768 gramas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerli metal miktarları için birim seçin. Bir troy ons 31,1034768 grama eşittir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите единицу для количества драгоценных металлов. Одна тройская унция равна 31,1034768 грамма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть одиницю для кількості дорогоцінних металів. Одна тройська унція дорівнює 31,1034768 грама."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali väärismetallide koguste ühik. Üks troiunts võrdub 31,1034768 grammiga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貴金属の量に使用する単位を選択します。1トロイオンスは31.1034768グラムです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀금속 수량에 사용할 단위를 선택하세요. 1트로이 온스는 31.1034768그램입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择贵金属数量使用的单位。1金衡盎司等于31.1034768克。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇貴金屬數量使用的單位。1金衡盎司等於31.1034768公克。"
          }
        }
      }
    },
