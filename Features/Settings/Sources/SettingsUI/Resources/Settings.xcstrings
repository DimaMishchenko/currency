    "dailyRateExplanation": {
      "extractionState": "manual",
      "comment": "Settings interface: dailyRateExplanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved for offline use. Bank fees aren’t included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存以供离线使用。不含银行手续费。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン用に保存済み。銀行手数料は含みません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados para uso sin conexión. No incluyen comisiones bancarias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Offline-Nutzung gespeichert. Bankgebühren sind nicht enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrés pour une utilisation hors ligne. Les frais bancaires ne sont pas inclus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvas para uso offline. Tarifas bancárias não estão incluídas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 사용을 위해 저장되었습니다. 은행 수수료는 포함되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存以供離線使用。不含銀行手續費。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati per l’uso offline. Le commissioni bancarie non sono incluse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı kullanım için kaydedildi. Banka ücretleri dahil değildir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранены для работы без интернета. Банковские комиссии не включены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено для роботи без інтернету. Банківські комісії не включено."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatud võrguühenduseta kasutamiseks. Pangatasud ei sisaldu."
          }
        }
      }
    },
