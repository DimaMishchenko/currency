    "locationSettingsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up your local currency or manage location access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置当地货币或管理定位访问。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現地通貨の設定や位置情報へのアクセスを管理します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura tu moneda local o gestiona el acceso a la ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deine lokale Währung ein oder verwalte den Standortzugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure ta devise locale ou gère l’accès à la position."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure sua moeda local ou gerencie o acesso à localização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지 통화를 설정하거나 위치 접근을 관리하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定當地貨幣或管理定位取用。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la valuta locale o gestisci l’accesso alla posizione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel para biriminizi ayarlayın veya konum erişimini yönetin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте местную валюту или управляйте доступом к местоположению."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте місцеву валюту або керуйте доступом до розташування."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadista kohalik valuuta või halda asukoha kasutamise luba."
          }
        }
      }
    },
