          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Lokal hinzu, um der Währung an deinem Standort zu folgen. Aktuell %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute Locale pour suivre la devise autour de toi. Actuellement %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione Local para acompanhar a moeda ao seu redor. Atualmente %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지를 추가하여 주변 통화를 따르세요. 현재 %1$@입니다."
