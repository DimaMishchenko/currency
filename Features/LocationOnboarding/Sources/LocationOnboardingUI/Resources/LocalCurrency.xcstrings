      "extractionState": "manual",
      "comment": "Local currency onboarding action or status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local currency is %1$@. It refreshes daily when the app or widgets are in use."
          }
        }
      }
    },
    "localReadyAppCurrency": {
      "extractionState": "manual",
      "comment": "A location-resolved currency is ready to be added to the main converter.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Local to follow the currency around you. Currently %1$@."
          }
        }
      }
    },
