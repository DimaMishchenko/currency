    "localFindingDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localFindingDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’re looking up a currency for this location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查询此位置的货币。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所の通貨を調べています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos buscando una moneda para esta ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir suchen eine Währung für diesen Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous recherchons une devise pour cette position."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos buscando uma moeda para esta localização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위치의 통화를 찾고 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查詢此位置的貨幣。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo cercando una valuta per questa posizione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konumun para birimi aranıyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы определяем валюту для этого местоположения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми визначаємо валюту для цього розташування."
          }
        }
      }
    },
