            "value": "ドラッグで回転、上下のスワイプで通貨を回せます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar o desliza arriba o abajo para rotar las monedas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe zum Drehen oder wische nach oben oder unten, um die Währungen zu drehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour faire tourner, ou balaye vers le haut ou le bas pour tourner les devises."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para girar ou deslize para cima ou para baixo para rodar as moedas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하거나 위아래로 쓸어넘겨 통화를 회전하세요."
