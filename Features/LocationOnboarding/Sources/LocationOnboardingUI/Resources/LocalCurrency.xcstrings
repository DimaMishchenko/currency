      "extractionState": "manual",
      "comment": "Widget onboarding: localRetry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "localSaved": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved local currency: %1$@ (%2$@)"
          }
        }
      }
    },
    "localServicesDisabled": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localServicesDisabled.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are off. Enable them in Settings to find your local currency."
          }
        }
      }
    },
    "localUnavailable": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is unavailable. Try again when you have a connection or a clearer signal."
          }
        }
      }
    },
    "localUnsupported": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported currency was found for this location."
          }
        }
      }
    },
