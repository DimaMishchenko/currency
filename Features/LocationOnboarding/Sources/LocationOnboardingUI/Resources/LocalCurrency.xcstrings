      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update the saved currency. Try again."
          }
        }
      }
    },
    "localSaveFailed": {
      "extractionState": "manual",
      "comment": "Shown when adding the successfully resolved local currency to the app fails.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t add this currency. Please try again."
          }
        }
      }
    },
