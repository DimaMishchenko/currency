    "localInitial": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location to find your local currency."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许定位以查找当地货币。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を許可して現地通貨を調べましょう。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la ubicación para encontrar tu moneda local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Standortzugriff, um deine lokale Währung zu ermitteln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise la position pour trouver ta devise locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a localização para encontrar sua moeda local."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 허용하여 현지 통화를 찾으세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許定位以尋找當地貨幣。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la posizione per trovare la valuta locale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel para biriminizi bulmak için konuma izin verin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к местоположению, чтобы определить местную валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до розташування, щоб визначити місцеву валюту."
          }
        }
      }
    },
    "localIntroDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localIntroDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the currency around you,\nready for the app and widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找您身边的货币，\n用于 App 和小组件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今いる場所の通貨を、\nアプリとウィジェットに。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra la moneda de tu entorno,\nlista para la app y los widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde die Währung um dich herum,\nbereit für App und Widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve la devise autour de toi,\nprête pour l’app et les widgets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre a moeda ao seu redor,\npronta para o app e os widgets."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변의 통화를 찾아\n앱과 위젯에서 사용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找您身邊的貨幣，\n用於 App 和小工具。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la valuta intorno a te,\npronta per l’app e i widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki para birimini bulun,\nuygulama ve araç takımları için hazır olsun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите валюту вокруг вас,\nдля приложения и виджетов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть валюту навколо вас,\nдля програми й віджетів."
          }
        }
      }
    },
    "localIntroTitle": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localIntroTitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel at home,\nanywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论身在何处，\n都如同在家。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいても、\n自分の場所に。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntete como en casa,\nen cualquier lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fühl dich zu Hause,\nüberall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme chez toi,\npartout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinta-se em casa,\nem qualquer lugar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나\n내 집처럼."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論身在何處，\n都如同在家。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiti a casa,\novunque."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerde\nevinizde hissedin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувствуйте себя дома,\nгде угодно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почувайтеся як удома,\nбудь-де."
          }
        }
      }
    },
    "localPermissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Allow location for Currency in Settings to update your local currency."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к местоположению отключён. Разрешите геолокацию для Currency в Настройках, чтобы обновить местную валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до розташування вимкнено. Дозвольте геолокацію для Currency в Параметрах, щоб оновити місцеву валюту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位访问已关闭。请在“设置”中允许 Currency 使用定位以更新当地货币。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスがオフです。現地通貨を更新するには「設定」でCurrencyの位置情報を許可してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Permite la ubicación para Currency en Ajustes para actualizar tu moneda local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist deaktiviert. Erlaube den Standortzugriff für Currency in den Einstellungen, um deine lokale Währung zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé. Autorise la position pour Currency dans Réglages pour actualiser ta devise locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desativado. Permita a localização para o Currency em Ajustes para atualizar sua moeda local."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근이 꺼져 있습니다. 현지 통화를 갱신하려면 설정에서 Currency의 위치를 허용하세요."
