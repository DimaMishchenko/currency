    "localAwaitingPermission": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localAwaitingPermission.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your permission…"
          }
        }
      }
    },
