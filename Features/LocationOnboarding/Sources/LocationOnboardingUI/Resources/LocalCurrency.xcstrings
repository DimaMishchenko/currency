    "localReadyCurrency": {
      "extractionState": "manual",
      "comment": "Local currency onboarding action or status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your local currency is %1$@. It refreshes daily when the app or widgets are in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的当地货币是%1$@。使用 App 或小组件时每日更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現地通貨は%1$@です。アプリやウィジェットの使用中に毎日更新されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu moneda local es %1$@. Se actualiza a diario cuando se usan la app o los widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine lokale Währung ist %1$@. Sie wird täglich aktualisiert, solange die App oder Widgets verwendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta devise locale est %1$@. Elle s’actualise chaque jour pendant l’utilisation de l’app ou des widgets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua moeda local é %1$@. Ela é atualizada diariamente quando o app ou os widgets estão em uso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지 통화는 %1$@입니다. 앱이나 위젯 사용 중 매일 갱신됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的當地貨幣是%1$@。使用 App 或小工具時每日更新。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua valuta locale è %1$@. Si aggiorna ogni giorno mentre usi l’app o i widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel para biriminiz %1$@. Uygulama veya araç takımları kullanımdayken günlük yenilenir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша местная валюта — %1$@. Она обновляется ежедневно, пока приложение или виджеты используются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша місцева валюта — %1$@. Вона оновлюється щодня, поки програма або віджети використовуються."
          }
        }
      }
    },
    "localReadyAppCurrency": {
      "extractionState": "manual",
      "comment": "A location-resolved currency is ready to be added to the main converter.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Local to follow the currency around you. Currently %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加“当地”以跟随您所在地的货币。目前为%1$@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
