    "localFindingTitle": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localFindingTitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your place\nin the world."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在寻找\n您的所在之处。"
