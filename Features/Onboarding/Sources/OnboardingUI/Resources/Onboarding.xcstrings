            "value": "沿圓圈拖移以轉動貨幣。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina lungo il cerchio per far girare le valute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimlerini döndürmek için çember boyunca sürükleyin."
          }
        },
        "ru": {
