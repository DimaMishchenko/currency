    "guideHoldHomeDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideHoldHomeDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty area of your Home Screen until the apps jiggle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住主屏幕空白区域，直到 App 开始晃动"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが揺れ始めるまでホーム画面の空いている場所を長押しします"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada un área vacía de la pantalla de inicio hasta que las apps tiemblen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen leeren Bereich deines Home-Bildschirms gedrückt, bis die Apps wackeln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le doigt sur une zone vide de ton écran d’accueil jusqu’à ce que les apps s’animent"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma área vazia da Tela de Início pressionada até os apps começarem a tremer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 흔들릴 때까지 홈 화면의 빈 공간을 길게 누르세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住主畫面空白區域，直到 App 開始晃動"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un’area vuota della schermata Home finché le app iniziano a muoversi"
