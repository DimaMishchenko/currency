    "guideChooseFamily": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideChooseFamily. Arguments stay together so translations can reorder them.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to %1$@, choose %2$@, and tap Add Widget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
