    "guideFinishLockDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideFinishLockDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the widget picker and tap Done to save your Lock Screen. Tap the icon anytime to open Currency."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭小组件选择器并轻点“完成”以保存锁定屏幕。随时轻点图标即可打开 Currency。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェット選択画面を閉じて「完了」をタップし、ロック画面を保存します。いつでもアイコンをタップしてCurrencyを開けます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el selector de widgets y toca OK para guardar la pantalla de bloqueo. Toca el icono cuando quieras para abrir Currency."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Widget-Auswahl und tippe auf Fertig, um deinen Sperrbildschirm zu speichern. Tippe jederzeit auf das Symbol, um Currency zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme le sélecteur de widgets et touche OK pour enregistrer ton écran verrouillé. Touche l’icône à tout moment pour ouvrir Currency."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o seletor de widgets e toque em OK para salvar a Tela Bloqueada. Toque no ícone a qualquer momento para abrir o Currency."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 선택기를 닫고 완료를 탭하여 잠금 화면을 저장하세요. 언제든 아이콘을 탭하면 Currency가 열립니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉小工具選擇器並點一下「完成」以儲存鎖定畫面。隨時點一下圖示即可打開 Currency。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il selettore di widget e tocca Fine per salvare la schermata di blocco. Tocca l’icona in qualsiasi momento per aprire Currency."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç takımı seçicisini kapatın ve Kilitli Ekranınızı kaydetmek için Bitti’ye dokunun. Currency’yi açmak için istediğiniz zaman simgeye dokunun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте выбор виджетов и нажмите «Готово», чтобы сохранить экран блокировки. Нажмите значок в любой момент, чтобы открыть Currency."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте вибір віджетів і торкніться «Готово», щоб зберегти замкнений екран. Торкніться значка будь-коли, щоб відкрити Currency."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulge vidinavalik ja kinnita muudatused, et lukustuskuva salvestada. Currency avamiseks puuduta ikooni millal tahes."
          }
        }
      }
    },
