    "guideHoldLockDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideHoldLockDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your iPhone, then touch and hold the Lock Screen to show your wallpapers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 iPhone，然后按住锁定屏幕以显示墙纸"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのロックを解除してからロック画面を長押しし、壁紙を表示します"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el iPhone y mantén pulsada la pantalla de bloqueo para ver tus fondos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre dein iPhone und halte den Sperrbildschirm gedrückt, um deine Hintergrundbilder anzuzeigen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouille ton iPhone, puis maintiens le doigt sur l’écran verrouillé pour afficher tes fonds d’écran"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o iPhone e mantenha a Tela Bloqueada pressionada para mostrar suas imagens de fundo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 잠금을 해제한 다음 잠금 화면을 길게 눌러 배경화면을 표시하세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖 iPhone，然後按住鎖定畫面以顯示背景圖片"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca l’iPhone, poi tieni premuta la schermata di blocco per mostrare gli sfondi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzun kilidini açın, ardından duvar kâğıtlarınızı göstermek için Kilitli Ekran’a dokunup basılı tutun"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте iPhone, затем нажмите и удерживайте экран блокировки, чтобы открыть обои"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відімкніть iPhone, потім торкніться й утримуйте замкнений екран, щоб відкрити шпалери"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava iPhone’i lukustus ja puuduta pikalt lukustuskuva, et näha taustapilte"
          }
        }
      }
    },
