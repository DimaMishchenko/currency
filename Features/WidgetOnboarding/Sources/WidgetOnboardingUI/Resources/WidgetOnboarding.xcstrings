    "guideFinishHomeDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideFinishHomeDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag your widget into place and tap Done to try it on your Home Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将小组件拖到合适位置，轻点“完成”以在主屏幕上使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを置きたい場所にドラッグし、「完了」をタップしてホーム画面で試しましょう"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el widget a su lugar y toca OK para probarlo en tu pantalla de inicio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe dein Widget an die gewünschte Stelle und tippe auf Fertig, um es auf deinem Home-Bildschirm auszuprobieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser ton widget en place et touche OK pour l’essayer sur ton écran d’accueil"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o widget para o lugar e toque em OK para experimentá-lo na Tela de Início"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 원하는 위치로 드래그하고 완료를 탭하여 홈 화면에서 사용해 보세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將小工具拖到合適位置，點一下「完成」以在主畫面上使用"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il widget al suo posto e tocca Fine per provarlo sulla schermata Home"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç takımınızı yerine sürükleyin ve Ana Ekranınızda denemek için Bitti’ye dokunun"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите виджет на место и нажмите «Готово», чтобы попробовать его на экране «Домой»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть віджет на місце й торкніться «Готово», щоб спробувати його на початковому екрані"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohista vidin sobivasse kohta ja kinnita paigutus, et seda avakuval proovida"
          }
        }
      }
    },
