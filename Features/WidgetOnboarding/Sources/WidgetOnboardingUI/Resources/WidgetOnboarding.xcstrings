    "guideHistoryPair": {
      "extractionState": "manual",
      "comment": "History widget discovery: guideHistoryPair.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts with your app’s base and first currency. Choose either currency here. For crypto, choose USD as the other currency."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始使用 App 的基准货币和第一种货币。可在此选择任一货币。对于加密货币，请选择 USD 作为另一种货币。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの基準通貨と最初の通貨で始まります。ここでどちらの通貨も変更できます。暗号資産の場合は、もう一方の通貨にUSDを選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza con la moneda base y la primera moneda de tu app. Elige cualquiera de las dos monedas aquí. Para criptomonedas, elige USD como la otra moneda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit der Basiswährung und der ersten Währung deiner App. Wähle hier eine der beiden Währungen. Wähle für Krypto USD als andere Währung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec la devise de base et la première devise de ton app. Choisis l’une ou l’autre ici. Pour les cryptos, choisis USD comme autre devise."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa com a moeda base e a primeira moeda do app. Escolha qualquer uma das moedas aqui. Para criptomoedas, escolha USD como a outra moeda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 기준 통화와 첫 번째 통화로 시작합니다. 여기에서 어느 통화든 선택할 수 있습니다. 암호화폐는 다른 통화로 USD를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初始使用 App 的基準貨幣和第一種貨幣。可在此選擇任一貨幣。對於加密貨幣，請選擇 USD 作為另一種貨幣。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con la base e la prima valuta dell’app. Qui puoi cambiare entrambe le valute. Per le criptovalute, scegli USD come altra valuta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanızın temel ve ilk para birimiyle başlar. Buradan her iki para birimini de seçebilirsiniz. Kripto için diğer para birimi olarak USD seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изначально используются базовая и первая валюты приложения. Здесь можно изменить любую из двух валют. Для криптовалют выберите USD второй валютой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку використовуються базова й перша валюти програми. Тут можна змінити будь-яку з двох валют. Для криптовалют виберіть USD другою валютою."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguses kasutatakse äpi baasvaluutat ja loendi esimest valuutat. Siin saad muuta mõlemat valuutat. Krüptovaluuta korral vali teiseks valuutaks USD."
          }
        }
      }
    },
