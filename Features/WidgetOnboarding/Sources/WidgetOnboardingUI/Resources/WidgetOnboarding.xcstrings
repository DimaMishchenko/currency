    "guideFinishEditDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideFinishEditDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap outside the settings to finish editing on your Home Screen; changes made in this tutorial are only a preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点设置外部以完成主屏幕编辑；本教程中的更改仅为预览"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の外側をタップするとホーム画面の編集が終了します。このチュートリアルの変更はプレビューのみです"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca fuera de los ajustes para terminar la edición en tu pantalla de inicio; los cambios de este tutorial solo son una vista previa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe außerhalb der Einstellungen, um die Bearbeitung auf deinem Home-Bildschirm abzuschließen; Änderungen in dieser Anleitung sind nur eine Vorschau"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche en dehors des réglages pour terminer la modification sur ton écran d’accueil ; les changements de ce tutoriel ne sont qu’un aperçu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque fora dos ajustes para concluir a edição na Tela de Início; as alterações deste tutorial são apenas uma prévia"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 바깥을 탭하여 홈 화면 편집을 마치세요. 이 안내에서 변경한 내용은 미리보기에만 적용됩니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下設定外部以完成主畫面編輯；本教學中的更改僅為預覽"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca fuori dalle impostazioni per finire la modifica sulla schermata Home; le modifiche in questo tutorial sono solo un’anteprima"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran’da düzenlemeyi bitirmek için ayarların dışına dokunun; bu eğitimdeki değişiklikler yalnızca önizlemedir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите вне настроек, чтобы завершить редактирование на экране «Домой»; изменения в этом уроке — только предпросмотр"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться поза параметрами, щоб завершити редагування на початковому екрані; зміни в цьому уроці — лише попередній перегляд"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avakuval muutmise lõpetamiseks puuduta seadetest väljaspool; selle juhendi muudatused on ainult eelvaate jaoks"
          }
        }
      }
    },
