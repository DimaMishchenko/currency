    "guideListsDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideListsDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default follows your app. Custom uses its own list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“默认”与 App 同步。“自定”使用独立列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」はアプリの通貨リストと連動し、「カスタム」は独自のリストを使います。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado sigue tu app. Personalizado usa su propia lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard folgt deiner App. Eigene Liste verwendet eine separate Auswahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut suit ton app. Personnalisée utilise sa propre liste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão acompanha o app. Personalizado usa sua própria lista."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 앱의 통화 목록과 동기화됩니다. 사용자 지정은 별도 목록을 사용합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」與 App 同步。「自訂」使用獨立列表。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito usa l’elenco di valute dell’app. Personalizzato usa il proprio elenco."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan, uygulamanızdaki para birimi listesini kullanır. Özel kendi listesini kullanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«По умолчанию» использует список валют приложения. «Свой» использует отдельный список."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Типово» використовує список валют програми. «Власний» використовує окремий список."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikimisi kasutab äpi valuutaloendit. Kohandatud loend kasutab eraldi valikut."
          }
        }
      }
    },
