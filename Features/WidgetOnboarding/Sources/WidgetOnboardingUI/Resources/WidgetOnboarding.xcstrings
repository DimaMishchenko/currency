    "guideLockCurrencyDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideLockCurrencyDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Currency, then tap Currency Icon to add it. Tap the placed icon to choose a symbol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Currency，然后轻点“货币图标”以添加。轻点已放置的图标以选择符号。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Currencyを選択し、「通貨アイコン」をタップして追加します。配置したアイコンをタップして記号を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Currency y toca Icono de moneda para añadirlo. Toca el icono colocado para elegir un símbolo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Currency und tippe auf Währungssymbol, um es hinzuzufügen. Tippe auf das platzierte Symbol, um ein Zeichen zu wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Currency, puis touche Icône de devise pour l’ajouter. Touche l’icône placée pour choisir un symbole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Currency e toque em Ícone de moeda para adicioná-lo. Toque no ícone colocado para escolher um símbolo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency를 선택한 다음 통화 아이콘을 탭하여 추가하세요. 배치한 아이콘을 탭하여 기호를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Currency，然後點一下「貨幣圖示」以加入。點一下已放置的圖示以選擇符號。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Currency, poi tocca Icona valuta per aggiungerla. Tocca l’icona posizionata per scegliere un simbolo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency’yi seçin, ardından eklemek için Para Birimi Simgesi’ne dokunun. Sembol seçmek için yerleştirilen simgeye dokunun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите Currency, затем нажмите «Значок валюты», чтобы добавить его. Нажмите размещённый значок, чтобы выбрать символ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть Currency, потім торкніться «Значок валюти», щоб додати його. Торкніться розміщеного значка, щоб вибрати символ."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Currency ja seejärel lisamiseks Valuutaikoon. Sümboli valimiseks puuduta lisatud ikooni."
          }
        }
      }
    },
