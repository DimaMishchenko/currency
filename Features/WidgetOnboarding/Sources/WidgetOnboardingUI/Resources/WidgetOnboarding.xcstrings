    "guideDefaultLocalDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideDefaultLocalDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default follows your app list, including Local. Add Local from Add currency in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“默认”与 App 中的货币列表同步，包括当地货币。请在 App 的“添加货币”中添加“当地货币”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」は現地通貨を含むアプリの通貨リストと連動します。アプリの「通貨を追加」から「現地通貨」を追加してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado sigue la lista de tu app, incluida Local. Añade Local desde Añadir moneda en la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard folgt deiner App-Liste, einschließlich Lokal. Füge Lokal über Währung hinzufügen in der App hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut suit la liste de ton app, dont Locale. Ajoute Locale depuis Ajouter une devise dans l’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão acompanha a lista do app, incluindo Local. Adicione Local em Adicionar moeda no app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 현지 통화를 포함한 앱의 통화 목록과 동기화됩니다. 앱의 통화 추가에서 현지 통화를 추가하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」與 App 中的貨幣列表同步，包括當地貨幣。請在 App 的「加入貨幣」中加入「當地貨幣」。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito segue l’elenco dell’app, inclusa Locale. Aggiungi Locale da Aggiungi valuta nell’app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan, Yerel dahil uygulama listenizi izler. Uygulamada Para birimi ekle’den Yerel’i ekleyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«По умолчанию» использует список приложения, включая местную валюту. Добавьте её через «Добавить валюту» в приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Типово» використовує список програми, включно з місцевою валютою. Додайте її через «Додати валюту» в програмі."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikimisi kasutab äpi valuutaloendit, sealhulgas kohalikku valuutat. Lisa Kohalik valuuta äpis valiku Lisa valuuta kaudu."
          }
        }
      }
    },
