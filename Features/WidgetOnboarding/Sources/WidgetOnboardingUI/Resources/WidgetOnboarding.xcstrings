    "guideBoardLocalDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideBoardLocalDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Local from the currency picker for a custom list, or include it in your app list when using Default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定列表请在货币选择器中选择“当地”；使用“默认”时，请将其加入 App 列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムリストでは通貨選択画面で「現地」を選択し、「デフォルト」ではアプリのリストに追加してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Local en el selector de monedas para una lista personalizada o inclúyela en la lista de tu app al usar Predeterminado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Lokal in der Währungsauswahl für eine eigene Liste oder füge sie bei Standard zur Liste deiner App hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Locale dans le sélecteur de devises pour une liste personnalisée, ou ajoute-la à la liste de ton app avec Par défaut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Local no seletor de moedas para uma lista personalizada ou inclua-a na lista do app ao usar Padrão."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 목록에서는 통화 선택기에서 현지를 선택하거나, 기본값을 사용할 때는 앱 목록에 포함하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂列表請在貨幣選擇器中選擇「當地」；使用「預設」時，請將其加入 App 列表。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Locale nel selettore di valute per un elenco personalizzato, oppure includila nell’elenco dell’app quando usi Predefinito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel liste için para birimi seçicisinden Yerel’i seçin veya Varsayılan’ı kullanırken uygulama listenize ekleyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для своего списка выберите местную валюту в списке выбора валют; для списка по умолчанию добавьте её в список приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для власного списку виберіть місцеву валюту в списку вибору валют; для типового списку додайте її до списку програми."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohandatud loendi jaoks vali valuutavalikust Kohalik valuuta. Valiku Vaikimisi korral lisa see äpi valuutaloendisse."
          }
        }
      }
    },
    "guideChooseAddDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideChooseAddDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add Widget in the Edit menu to open the widget gallery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“编辑”菜单中的“添加小组件”以打开小组件库"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」メニューの「ウィジェットを追加」をタップしてギャラリーを開きます"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Añadir widget en el menú Editar para abrir la galería de widgets"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe im Menü Bearbeiten auf Widget hinzufügen, um die Widget-Galerie zu öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Ajouter un widget dans le menu Modifier pour ouvrir la galerie de widgets"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Adicionar Widget no menu Editar para abrir a galeria de widgets"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 메뉴에서 위젯 추가를 탭하여 위젯 갤러리를 여세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「編輯」選單中的「加入小工具」以打開小工具展示區"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Aggiungi widget nel menu Modifica per aprire la galleria dei widget"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç takımı galerisini açmak için Düzenle menüsünde Araç Takımı Ekle’ye dokunun"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Добавить виджет» в меню «Править», чтобы открыть галерею виджетов"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «Додати віджет» у меню «Змінити», щоб відкрити галерею віджетів"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava avakuva muutmise menüü ja vali vidina lisamine. Menüüde nimetused sõltuvad iPhone’i süsteemikeelest."
          }
        }
      }
    },
