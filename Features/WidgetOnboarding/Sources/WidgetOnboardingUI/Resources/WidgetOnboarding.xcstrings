    "guidePairLocalDetail": {
      "extractionState": "manual",
      "comment": "Local selection instructions for pair widgets.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Comparison, then select Local currency in the Location section."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“比较”，然后在“位置”部分选择“当地货币”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「比較」を選択し、「位置情報」セクションで「現地通貨」を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Comparación y selecciona Local en la sección Ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Vergleich und dann Lokal im Bereich Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Comparaison, puis sélectionne Locale dans la section Position."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Comparação e selecione Local na seção Localização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교를 선택한 다음 위치 섹션에서 현지 통화를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「比較」，然後在「位置」區段選擇「當地貨幣」。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Confronto, poi seleziona Valuta locale nella sezione Posizione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma’yı, ardından Konum bölümünde Yerel para birimi’ni seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Сравнение», затем «Местная валюта» в разделе «Местоположение»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Порівняння», потім «Місцева валюта» в розділі «Розташування»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Võrdlusvaluuta, seejärel Kohalik valuuta jaotises Asukoht."
          }
        }
      }
    },
    "guideCustomLocalDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideCustomLocalDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Add currency, then select Local currency in the Location section. It stays separate from currencies selected by code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“添加货币”，然后在“位置”部分选择“当地货币”。该选项与指定的固定货币相互独立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「通貨を追加」を選択し、「位置情報」セクションで「現地通貨」を選択します。特定の通貨とは別の選択として保持されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Añadir moneda y selecciona Local en la sección Ubicación. Se mantiene como selección independiente de las monedas fijas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Währung hinzufügen und dann Lokal im Bereich Standort. Sie bleibt eine separate Auswahl neben festen Währungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Ajouter une devise, puis sélectionne Locale dans la section Position. Elle reste distincte des devises fixes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Adicionar moeda e selecione Local na seção Localização. Ela permanece uma seleção separada das moedas fixas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 추가를 선택한 다음 위치 섹션에서 현지 통화를 선택하세요. 특정 통화와는 별도로 선택됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「加入貨幣」，然後在「位置」區段選擇「當地貨幣」。此選項與指定的固定貨幣相互獨立。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Aggiungi valuta, poi seleziona Valuta locale nella sezione Posizione. Rimane una selezione separata dalle valute fisse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi ekle’yi, ardından Konum bölümünde Yerel para birimi’ni seçin. Sabit para birimlerinden ayrı bir seçim olarak kalır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Добавить валюту», затем «Местная валюта» в разделе «Местоположение». Этот выбор сохраняется отдельно от фиксированных валют."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Додати валюту», потім «Місцева валюта» в розділі «Розташування». Цей вибір зберігається окремо від фіксованих валют."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Lisa valuuta ja seejärel jaotises Asukoht valik Kohalik valuuta. See jääb koodi järgi valitud valuutadest eraldi valikuks."
          }
        }
      }
    },
    "guideCustomizeDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: guideCustomizeDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
