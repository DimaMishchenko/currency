    "guideHistoryRangeDetail": {
      "extractionState": "manual",
      "comment": "History widget discovery: guideHistoryRangeDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one week, one month, three months, one year, or all history. The widget refreshes daily. Green means the rate increased; red means it decreased."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一周、一个月、三个月、一年或全部历史。小组件每日刷新。绿色表示汇率上涨，红色表示下跌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1週間、1か月、3か月、1年、またはすべての履歴を選択。ウィジェットは毎日更新します。緑はレートの上昇、赤は下落を示します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una semana, un mes, tres meses, un año o todo el historial. El widget se actualiza a diario. Verde indica que el tipo subió; rojo, que bajó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Woche, einen Monat, drei Monate, ein Jahr oder den gesamten Verlauf. Das Widget wird täglich aktualisiert. Grün bedeutet, dass der Kurs gestiegen ist; Rot, dass er gefallen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une semaine, un mois, trois mois, un an ou tout l’historique. Le widget s’actualise chaque jour. Le vert indique une hausse du taux ; le rouge une baisse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma semana, um mês, três meses, um ano ou todo o histórico. O widget é atualizado diariamente. Verde significa que a taxa aumentou; vermelho, que diminuiu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1주, 1개월, 3개월, 1년 또는 전체 환율 기록을 선택하세요. 위젯은 매일 갱신됩니다. 초록색은 환율 상승, 빨간색은 하락을 뜻합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一週、一個月、三個月、一年或全部歷史。小工具每日重新整理。綠色表示匯率上漲，紅色表示下跌。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una settimana, un mese, tre mesi, un anno o tutta la cronologia. Il widget si aggiorna ogni giorno. Il verde indica un aumento del tasso; il rosso una diminuzione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta, bir ay, üç ay, bir yıl veya tüm geçmişi seçin. Araç takımı günlük yenilenir. Yeşil kurun arttığını, kırmızı azaldığını gösterir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите неделю, месяц, три месяца, год или всю историю. Виджет обновляется ежедневно. Зелёный означает рост курса, красный — снижение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть тиждень, місяць, три місяці, рік або всю історію. Віджет оновлюється щодня. Зелений означає зростання курсу, червоний — зниження."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali üks nädal, üks kuu, kolm kuud, üks aasta või kogu ajalugu. Vidinat värskendatakse iga päev. Roheline tähendab kursi tõusu, punane langust."
          }
        }
      }
    },
