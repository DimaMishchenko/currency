    "historyIntradayUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24-hour history is unavailable for fiat currencies. Choose 1W or a longer range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法定货币不提供 24 小时历史。请选择 1 周或更长范围。"
          }
        },
        "ja": {
          "stringUnit": {
