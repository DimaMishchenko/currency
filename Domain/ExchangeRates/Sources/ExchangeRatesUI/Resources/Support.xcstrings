    "historyIntradayUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24-hour history is unavailable for fiat currencies. Choose 1W or a longer range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法定货币不提供 24 小时历史。请选择 1 周或更长范围。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法定通貨の24時間履歴は利用できません。1週間以上の期間を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de 24 horas no está disponible para monedas fiduciarias. Elige 1S o un periodo mayor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Fiatwährungen ist kein 24-Stunden-Verlauf verfügbar. Wähle 1W oder einen längeren Zeitraum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique sur 24 heures est indisponible pour les devises fiduciaires. Choisis 1S ou une période plus longue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de 24 horas não está disponível para moedas fiduciárias. Escolha 1S ou um período maior."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법정 통화는 24시간 환율 데이터를 제공하지 않습니다. 1주 이상의 기간을 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "法定貨幣不提供 24 小時歷史。請選擇 1 週或更長範圍。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia di 24 ore non è disponibile per le valute tradizionali. Scegli 1S o un periodo più lungo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtibari para birimleri için 24 saatlik geçmiş kullanılamıyor. 1H veya daha uzun bir aralık seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История за 24 часа недоступна для обычных валют. Выберите 1Н или более длительный период."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія за 24 години недоступна для звичайних валют. Виберіть 1Т або довший період."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavavaluutade 24 tunni ajalugu pole saadaval. Vali 1n või pikem periood."
          }
        }
      }
    },
    "historySaveFailed": {
