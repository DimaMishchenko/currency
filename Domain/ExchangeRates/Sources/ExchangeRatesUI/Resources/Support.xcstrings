    "cryptoFallback": {
      "extractionState": "manual",
      "comment": "Support interface: cryptoFallback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some crypto rates use the daily fallback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分加密货币汇率使用每日备用数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の暗号資産レートは日次の代替レートを使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos tipos de cambio de criptomonedas usan los datos diarios de respaldo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Kryptokurse verwenden den täglichen Ersatzkurs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains taux de cryptomonnaies utilisent les données quotidiennes de secours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas taxas de câmbio de criptomoedas usam os dados diários de reserva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 암호화폐 환율은 일일 대체 환율을 사용합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分加密貨幣匯率使用每日備用資料。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni tassi delle criptovalute usano i dati giornalieri della fonte di riserva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kripto paralar için günlük yedek kurlar kullanılır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для некоторых криптовалют используются резервные ежедневные курсы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для деяких криптовалют використовуються резервні щоденні курси."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõne krüptovaluuta puhul kasutatakse varuvariandina päevakursse."
          }
        }
      }
    },
