    "cryptoFallback": {
      "extractionState": "manual",
      "comment": "Support interface: cryptoFallback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some crypto rates couldn’t be updated. Showing saved rates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分加密货币汇率无法更新。正在显示已保存的汇率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の暗号資産レートを更新できませんでした。保存済みのレートを表示しています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar algunos tipos de cambio de criptomonedas. Se muestran los tipos guardados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Kryptokurse konnten nicht aktualisiert werden. Gespeicherte Kurse werden angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains taux de cryptomonnaies n’ont pas pu être actualisés. Les taux enregistrés sont affichés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar algumas taxas de câmbio de criptomoedas. Exibindo as taxas salvas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 암호화폐 환율을 업데이트하지 못했습니다. 저장된 환율을 표시합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分加密貨幣匯率無法更新。正在顯示已儲存的匯率。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare alcuni tassi delle criptovalute. Vengono mostrati i tassi salvati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kripto para kurları güncellenemedi. Kayıtlı kurlar gösteriliyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить некоторые курсы криптовалют. Показаны сохранённые курсы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити деякі курси криптовалют. Показано збережені курси."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõnda krüptovaluutakurssi ei saanud uuendada. Kuvatakse salvestatud kursid."
          }
        }
      }
    },
