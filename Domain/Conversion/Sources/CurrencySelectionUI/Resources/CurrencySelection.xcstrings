{
  "sourceLanguage": "en",
  "strings": {
    "selectionSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save this currency selection. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存所选货币。请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通貨の選択を保存できませんでした。もう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar esta selección de monedas. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Währungsauswahl konnte nicht gespeichert werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer cette sélection de devises. Réessaie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar esta seleção de moedas. Tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 선택을 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存所選貨幣。請再試一次。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questa selezione di valute. Riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para birimi seçimi kaydedilemedi. Lütfen tekrar deneyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить выбранные валюты. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти вибрані валюти. Спробуйте ще раз."
          }
        }
      }
    },
