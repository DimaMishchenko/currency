    "mentalDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiply or divide by a rounded number for quick estimates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用近似数值进行乘除，快速估算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸めた数で掛け算や割り算をして、すばやく概算できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplica o divide por un número redondeado para hacer estimaciones rápidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multipliziere oder teile durch eine gerundete Zahl, um Werte schnell abzuschätzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
