          "stringUnit": {
            "state": "translated",
            "value": "Choose a currency manually"
          }
        }
      }
    },
    "localFinding": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding local currency…"
          }
        }
      }
    },
    "localFindingDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localFindingDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’re looking up a currency for this location."
          }
        }
      }
    },
    "localFindingProgress": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localFindingProgress.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your currency…"
          }
        }
      }
    },
    "localFindingTitle": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localFindingTitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your place\nin the world."
          }
        }
      }
    },
    "localInitial": {
      "extractionState": "manual",
      "comment": "Configurable widget collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Update to set up local currency. Last-known currency remains available after authorized lookup failures."
          }
        }
      }
    },
    "localIntroDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localIntroDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the currency around you,\nready for your widget."
          }
        }
      }
    },
    "localIntroTitle": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localIntroTitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel at home,\nanywhere."
          }
        }
      }
    },
    "localManualInstructions": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localManualInstructions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this currency to your app list. For a Custom widget, choose it directly in Edit Widget instead of Local currency."
          }
        }
      }
    },
    "localManualSaveFailed": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localManualSaveFailed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save. Please try again."
          }
        }
      }
    },
    "localManualSaved": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localManualSaved.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to your app currencies. Default widgets follow this list. For a Custom widget, choose this currency in Edit Widget."
          }
        }
      }
    },
    "localPermissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Allow location for Currency in Settings to update your local currency."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к геопозиции отключён. Разрешите доступ для Currency в Настройках, чтобы обновить местную валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до геопозиції вимкнено. Дозвольте доступ для Currency в Параметрах, щоб оновити місцеву валюту."
          }
        }
      }
    },
    "localPermissionRestricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is restricted on this device. Your local currency could not be updated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к геопозиции ограничен на этом устройстве. Не удалось обновить местную валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до геопозиції обмежено на цьому пристрої. Не вдалося оновити місцеву валюту."
          }
        }
      }
    },
    "localPrivacyDetail": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localPrivacyDetail.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the country and currency are saved."
          }
        }
      }
    },
    "localPrivacySummary": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localPrivacySummary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate location. Only when you ask."
          }
        }
      }
    },
    "localRecoveryTitle": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localRecoveryTitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your currency.\nYour choice."
          }
        }
      }
    },
    "localRegionMap": {
      "extractionState": "manual",
      "comment": "Widget onboarding: localRegionMap. Arguments stay together so translations can reorder them.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Region map for %1$@. No exact location is shown."
          }
        }
      }
    },
