    "providerExplanation": {
      "extractionState": "manual",
      "comment": "Converter interface: providerExplanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter v2 for daily fiat rates, with direct ECB fallback. Fawaz supplies daily crypto and backup rates. Coinbase public market data is checked every 30 minutes while active, falling back to daily crypto rates if unavailable. iOS schedules widget refreshes. No accounts or API keys."
          }
        }
      }
    },
