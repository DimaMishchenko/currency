    "widgetRefreshExplanation": {
      "extractionState": "manual",
      "comment": "Converter interface: widgetRefreshExplanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiat rates are daily. Crypto checks Coinbase every 30 minutes, with daily fallback. Rates are cached offline. iOS controls widget refresh timing; keypad updates may take a moment."
          }
        }
      }
    },
