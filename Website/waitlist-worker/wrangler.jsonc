{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currency-launch-waitlist",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "currency-signup.dimasike.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "currency-waitlist",
    "database_id": "94ff1d77-3990-4804-9d75-d2049a2a4a80",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "WAITLIST_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
